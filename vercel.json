{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "public",
  "buildCommand": "",
  "rewrites": [{ "source": "/issue/:ark", "destination": "/issue" }],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/covers/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
